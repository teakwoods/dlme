# Database
DB_NAME=dlme_wp
DB_USER=dlme_user
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

# WordPress
WP_URL=http://localhost:8080
WP_TITLE="DLme Marketplace"
WP_ADMIN_USER=admin
WP_ADMIN_PASS=change_me_admin_password
WP_ADMIN_EMAIL=you@example.com
WP_ENV=development

# HTTP port mapping for nginx in dev (host:container)
HTTP_PORT=8080

# Image tag for prod/staging deployments (used with docker-compose.prod.yml)
IMAGE_TAG=latest
